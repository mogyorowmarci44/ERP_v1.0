# Neon pooled connection string (Neon console → Connection details → Pooled)
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/mm_erp?sslmode=require
# Hosszú, véletlen titok a session cookie aláírásához (pl. `openssl rand -base64 48`)
SESSION_SECRET=change-me-to-a-long-random-string
# v6.0.0 – Az ERP nyilvános címe a meghívó és jelszó-visszaállító linkekhez (pl. https://mm-erp.onrender.com)
APP_URL=
# v6.1.0 – Érzékeny személyes adatok (adóazonosító, anyja neve, születési hely, lakcím) titkosítási kulcsa:
# openssl rand -base64 32 – a kulcsot őrizd meg külön is, nélküle ezek az adatok nem olvashatók vissza.
DATA_ENCRYPTION_KEY=
# v6.7.0 – Bizonylatfájlok a Neon fájltárolóban (Object Storage)
FILES_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# v6.7.0 – E-mail saját domainről: brevo vagy resend
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=
